# Environment / secrets — never commit real values.
# backend/src/main/resources/application.properties.example is tracked and
# holds placeholders only; the real file (if it ever contains a real value
# instead of an env-var reference) stays local.
.env
.env.local
.env.*.local
backend/src/main/resources/application.properties
